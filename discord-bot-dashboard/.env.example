# Discord OAuth (OAuth2 → URL Generator / Redirects in Developer Portal).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect URL configured for the application (e.g. https://your-host/api/auth/discord/callback).
DISCORD_REDIRECT_URI=

# Bot token used server-side for Discord API (bootstrap, resources, send-test, etc.).
DISCORD_BOT_TOKEN=

# Persistence: "json" = shared-data files (default). "postgres" = tables guild_configs + bot_guild_state (see docs/sql/001_init_timbrabot.sql).
PERSISTENCE_DRIVER=json

# Required when PERSISTENCE_DRIVER=postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=false
# PG_POOL_MAX=10

# Absolute path to the shared-data directory (config.json, bot-state.json, assets, fonts).
# Must match SHARED_DATA_DIR in discord-bot when both processes run.
# Default if unset: ../shared-data relative to process cwd.
SHARED_DATA_DIR=

# Optional: set to 1 for extra logging around shared-data / bot-state reads (development).
# DEBUG_SHARED_DATA=
