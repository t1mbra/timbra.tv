# Discord bot token (Bot section in Discord Developer Portal).
DISCORD_TOKEN=

# Persistence: "json" = shared-data files (default). "postgres" = tables guild_configs + bot_guild_state (see docs/sql/001_init_timbrabot.sql).
PERSISTENCE_DRIVER=json

# Required when PERSISTENCE_DRIVER=postgres (connection string from Railway, Neon, etc.).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional SSL for managed Postgres (set if connection requires SSL and driver does not infer it).
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=false

# Optional pool size (default 10).
# PG_POOL_MAX=10

# Absolute path to the shared-data directory (config, bot-state, fonts).
# Must match SHARED_DATA_DIR in discord-bot-dashboard when both processes run.
# Default if unset: ../shared-data relative to process cwd.
SHARED_DATA_DIR=

# Optional: set to 1 for extra logging around shared-data / bot-state reads (development).
# DEBUG_SHARED_DATA=
